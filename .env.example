GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REFRESH_TOKEN=change-me
PORT=3000
# Paid prices in USD per 1M tokens, used only for the cost-per-1000-posts number.
# Check the current price on Google's pricing page and update these.
INPUT_PRICE_PER_M=0.30
OUTPUT_PRICE_PER_M=2.50
# Adzuna test keys allow 25 calls in total; raise this after activation (e.g. 30)
ADZUNA_MAX_CALLS=20
# Set to 1 on the deployed host so an empty database fills on boot
BOOT_REFRESH=0
